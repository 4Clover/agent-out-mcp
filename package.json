{
  "name": "agent-link-mcp",
  "version": "2.0.0",
  "description": "MCP server that spawns CLI agents as subprocesses with bidirectional communication",
  "type": "module",
  "bin": {
    "agent-link-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "which": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/which": "^3.0.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
